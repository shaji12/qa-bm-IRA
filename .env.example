# TEMPLATE ONLY — this is the one env file that IS committed. Never put real
# credentials in here.
#
# There is one env file per instance, and they all use the SAME variable names.
# Copy this file once per instance you use:
#
#   .env.alpha      npm run test:alpha      (the default when TEST_ENV is unset)
#   .env.staging    npm run test:staging
#   .env.prod       npm run test:prod
#
# All three are gitignored. Because the names never change, no page object,
# fixture or spec has to know which instance it is running against — only the
# values behind these variables differ.
#
# Every project needs three variables: <PROJECT_KEY>_URL / _USER / _PASS.
# PROJECT_KEY must match the key in src/config/environments.js.
#
# There is no _API_URL. API testing was removed from the framework to be rebuilt
# from scratch; a rebuild adds the variable back here and in environments.js.

# --- Loyaltri ---
LOYALTRI_URL=https://alpha.loyaltri.com
LOYALTRI_USER=testuser@example.com
LOYALTRI_PASS=changeme

# --- Next project (uncomment and rename when you add one) ---
# MONTES_URL=
# MONTES_USER=
# MONTES_PASS=


# ===========================================================================
# TestLink
#
# These go in `.env` (the SHARED file), not .env.alpha / .env.staging /
# .env.prod. There is one TestLink server recording results for every app
# instance you test, so they don't change when TEST_ENV does.
#
# TESTLINK_KEY is PER PERSON. TestLink stamps every execution with the key's
# owner, so sharing one key destroys the record of who actually ran what.
# Generate yours: TestLink -> My Settings -> Generate a new API key.
#
# Used by:  npm run testlink -- --build "Sprint-24-RC1"
# ===========================================================================

TESTLINK_URL=https://testlink.loyaltri.in
TESTLINK_KEY=
TESTLINK_LOGIN=
TESTLINK_PROJECT=Loyaltri

# Default plan. Override per run with --plan "Other Plan".
TESTLINK_PLAN=
