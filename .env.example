# TEMPLATE ONLY — this is the one env file that IS committed. Never put real
# credentials in here.
#
# There is one env file per instance, and they all use the SAME variable names.
# Copy this file once per instance you use:
#
#   .env.qa       npm run test:qa      (the default when TEST_ENV is unset)
#   .env.prod     npm run test:prod
#
# Both are gitignored. Because the names never change, no page object,
# fixture or spec has to know which instance it is running against — only the
# values behind these variables differ.
#
# BM_CANTEEN_URL is the site root. Each role (admin, parent, student) then has
# its own login page and account: <PROJECT_KEY>_<ROLE>_URL / _USER / _PASS.
# The names must match src/config/environments.js.

# --- BM Canteen ---
BM_CANTEEN_URL=https://canteen-demo.globtech.in

# Master Admin
BM_CANTEEN_ADMIN_URL=https://canteen-demo.globtech.in/login
BM_CANTEEN_ADMIN_USER=admin@example.com
BM_CANTEEN_ADMIN_PASS=changeme

# Parent (not automated yet — uncomment together with the role in environments.js)
# BM_CANTEEN_PARENT_URL=
# BM_CANTEEN_PARENT_USER=
# BM_CANTEEN_PARENT_PASS=


# ===========================================================================
# TestLink
#
# These go in `.env` (the SHARED file), not .env.qa / .env.prod. There is one
# TestLink server recording results for every app instance you test, so they
# don't change when TEST_ENV does.
#
# TESTLINK_KEY is PER PERSON. TestLink stamps every execution with the key's
# owner, so sharing one key destroys the record of who actually ran what.
# Generate yours: TestLink -> My Settings -> Generate a new API key.
#
# Used by:  npm run testlink -- --build "Sprint-24-RC1"
# ===========================================================================

TESTLINK_URL=https://testlink.loyaltri.in
TESTLINK_KEY=
TESTLINK_LOGIN=
# The BM Canteen test project's name, exactly as TestLink shows it.
TESTLINK_PROJECT=

# Default plan. Override per run with --plan "Other Plan".
TESTLINK_PLAN=
