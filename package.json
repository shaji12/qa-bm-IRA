{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Playwright automation for BM Canteen",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:qa:sanity": "cross-env TEST_ENV=qa playwright test --grep @sanity",
    "test:qa:functional": "cross-env TEST_ENV=qa playwright test --grep \"@sanity|@functional\"",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:prod:sanity": "cross-env TEST_ENV=prod playwright test --grep @sanity",
    "test:prod:functional": "cross-env TEST_ENV=prod playwright test --grep \"@sanity|@functional\"",
    "test:prod:unsafe": "cross-env TEST_ENV=prod ALLOW_PROD=true playwright test",
    "testlink": "node scripts/run-assigned.js",
    "testlink:dry": "node scripts/run-assigned.js --dry-run",
    "testlink:prod": "cross-env TEST_ENV=prod node scripts/run-assigned.js",
    "list": "playwright test --list",
    "report:qa": "playwright show-report reports/qa/html-report",
    "report:prod": "playwright show-report reports/prod/html-report",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5"
  }
}
